{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Juan Flasher",
  "version": "4.0.2",
  "identifier": "com.kennyneutron.juan-flasher",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Juan Flasher v4.0.2 | By KennyNeutron",
        "width": 800,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": ["../tools/**/*"],
    "icon": ["../assets/juanrobotix_icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false
      }
    }
  }
}
